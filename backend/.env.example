# EMC CMS Backend -- environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored.
# Values here are development defaults; every deployed environment must
# override SECRET_KEY, the database and Redis URLs, and the CORS origins.

# Application
PROJECT_NAME="Church Management System API"
VERSION="0.1.0"

# API version prefix. The frontend's NEXT_PUBLIC_API_URL must point at the
# same value (see OQ-API-01 in docs/backend-api-map.md).
API_V1_STR="/api/v1"

# development | test | staging | production
# staging and production refuse to start with an unset SECRET_KEY, DEBUG=true,
# a "*" CORS origin, or DATABASE_ECHO=true.
ENVIRONMENT="development"
DEBUG=false

# Serve /api/v1/docs and /redoc. Defaults to true outside staging/production.
# ENABLE_DOCS=true

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"

# Explicit allow-list; "*" is rejected in deployed environments because
# credentials are permitted.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL, async driver only)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/emc_church_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Logs every statement *including bound parameters*; never enable in a
# deployed environment.
DATABASE_ECHO=false

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
# Runs tasks inline instead of dispatching them. Test suites only.
CELERY_TASK_ALWAYS_EAGER=false

# Object storage (S3-compatible: AWS S3, MinIO, Cloudflare R2)
STORAGE_BACKEND="local"
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION="us-east-1"
S3_BUCKET_NAME="emc-church-vault"

# Observability
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# json for deployed environments, console for local development
LOG_FORMAT="console"
LOG_EXCLUDE_PATHS="/api/v1/health"
READINESS_TIMEOUT_SECONDS=3.0
